<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="450.0" prefWidth="750.0" stylesheets="/css/style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.AddMember.Add_Member_Page_Controller">
    <children>
        <!-- Page Header -->
        <Label layoutX="60.0" layoutY="25.0" text="Register New Member">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <!-- Form Labels & Text Fields -->
        <Label layoutX="60.0" layoutY="80.0" style="-fx-font-weight: bold;" text="Member ID :" />
        <TextField fx:id="txtMemberID" layoutX="180.0" layoutY="75.0" prefHeight="30.0" prefWidth="280.0" promptText="Enter member ID..." />

        <Label layoutX="60.0" layoutY="130.0" style="-fx-font-weight: bold;" text="Full Name :" />
        <TextField fx:id="txtFullName" layoutX="180.0" layoutY="125.0" prefHeight="30.0" prefWidth="280.0" promptText="Enter full name..." />

        <Label layoutX="60.0" layoutY="180.0" style="-fx-font-weight: bold;" text="Email :" />
        <TextField fx:id="txtEmail" layoutX="180.0" layoutY="175.0" prefHeight="30.0" prefWidth="280.0" promptText="Enter email address..." />

        <Label layoutX="60.0" layoutY="230.0" style="-fx-font-weight: bold;" text="Mobile Number :" />
        <TextField fx:id="txtContactNb" layoutX="180.0" layoutY="225.0" prefHeight="30.0" prefWidth="280.0" promptText="Enter mobile number..." />

        <Label layoutX="60.0" layoutY="280.0" style="-fx-font-weight: bold;" text="Address :" />
        <TextField fx:id="txtAddress" layoutX="180.0" layoutY="275.0" prefHeight="30.0" prefWidth="280.0" promptText="Enter address..." />

        <!-- Action Buttons -->
        <Button fx:id="btnAddMember" layoutX="180.0" layoutY="345.0" mnemonicParsing="false" onAction="#btnOnActionAddMember" prefHeight="32.0" prefWidth="130.0" style="-fx-background-color: #27ae60; -fx-text-fill: white;" text="Add Member" />
        <Button fx:id="btnReset" layoutX="330.0" layoutY="345.0" mnemonicParsing="false" onAction="#btnOnActionReset" prefHeight="32.0" prefWidth="130.0" text="Reset" />
    </children>
</AnchorPane>