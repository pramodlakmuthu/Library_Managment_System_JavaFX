<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="588.0" prefWidth="746.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.Return_Book.Return_Book_Page_Controller">
    <children>
        <!-- Page Title -->
        <Label layoutX="50.0" layoutY="30.0" text="Return Book Management">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>

        <!-- Search Section -->
        <Label layoutX="50.0" layoutY="90.0" text="Issue ID / Reference :" />
        <TextField fx:id="txtSearchIssueId" layoutX="200.0" layoutY="85.0" prefHeight="26.0" prefWidth="250.0" promptText="Enter Issue ID (e.g. ISS-001)" />
        <Button fx:id="btnSearch" layoutX="470.0" layoutY="85.0" mnemonicParsing="false" onAction="#btnOnActionSearch" prefHeight="26.0" prefWidth="90.0" style="-fx-background-color: #2196F3; -fx-text-fill: white;" text="Search" />

        <!-- Member & Book Information Display -->
        <Label layoutX="50.0" layoutY="150.0" text="Member Info :" />
        <TextField fx:id="txtMemberInfo" editable="false" layoutX="200.0" layoutY="145.0" prefHeight="26.0" prefWidth="360.0" promptText="Member details will appear here..." />

        <Label layoutX="50.0" layoutY="210.0" text="Book Info :" />
        <TextField fx:id="txtBookInfo" editable="false" layoutX="200.0" layoutY="205.0" prefHeight="26.0" prefWidth="360.0" promptText="Book details will appear here..." />

        <!-- Dates Section -->
        <Label layoutX="50.0" layoutY="270.0" text="Borrow Date :" />
        <DatePicker fx:id="dateBorrow" disable="true" layoutX="200.0" layoutY="265.0" prefHeight="26.0" prefWidth="250.0" />

        <Label layoutX="50.0" layoutY="330.0" text="Due Date :" />
        <DatePicker fx:id="dateDue" disable="true" layoutX="200.0" layoutY="325.0" prefHeight="26.0" prefWidth="250.0" />

        <Label layoutX="50.0" layoutY="390.0" text="Return Date :" />
        <DatePicker fx:id="dateReturn" layoutX="200.0" layoutY="385.0" onAction="#dateReturnOnAction" prefHeight="26.0" prefWidth="250.0" />

        <!-- Overdue Status Warning Label -->
        <Label fx:id="lblOverdueStatus" layoutX="200.0" layoutY="430.0" prefHeight="25.0" prefWidth="360.0">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Label>

        <!-- Action Buttons -->
        <Button fx:id="btnReturnBook" layoutX="200.0" layoutY="480.0" mnemonicParsing="false" onAction="#btnOnActionReturnBook" prefHeight="35.0" prefWidth="130.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Return Book">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Button>
        <Button fx:id="btnClear" layoutX="350.0" layoutY="480.0" mnemonicParsing="false" prefHeight="35.0" prefWidth="100.0" text="Clear" />
    </children>
</AnchorPane>