<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<AnchorPane prefHeight="628.0" prefWidth="797.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.Main_DashBoard_page_Controller">
    <children>
        <!-- Navigation Bar (Always visible at the top) -->
        <HBox fx:id="navBarBox" layoutX="128.0" layoutY="21.0" prefHeight="36.0" prefWidth="518.0" spacing="10.0">
            <children>
                <Button fx:id="btnDashboard" mnemonicParsing="false" onAction="#btnOnActionDashboard" text="DashBoard" />
                <Button fx:id="btnAddBook" mnemonicParsing="false" onAction="#btnOnActionAddBook" text="Add Book" />
                <Button fx:id="btnAddMember" mnemonicParsing="false" onAction="#btnOnActionAddMember" text="Add Member" />
                <Button fx:id="btnView" mnemonicParsing="false" onAction="#btnOnActionView" text="View" />
                <Button fx:id="btnIssueBook" mnemonicParsing="false" onAction="#btnOnActionIssueBook" text="Issue Book" />
                <Button fx:id="btnReturnBook" mnemonicParsing="false" onAction="#btnOnActionReturnBook" text="Return Book" />
                <Button fx:id="btnHistory" mnemonicParsing="false" onAction="#btnOnActionHistory" prefHeight="26.0" prefWidth="58.0" text="History" />
            </children>
        </HBox>

        <!-- Content Area (Sub-pages like Add Book load inside here, leaving the nav bar alone) -->
        <StackPane fx:id="contentPane" layoutX="50.0" layoutY="80.0" prefHeight="450.0" prefWidth="700.0">
            <children>
                <!-- Default Dashboard Content / Statistics Fields -->
                <AnchorPane fx:id="dashboardContentPane" prefHeight="450.0" prefWidth="700.0">
                    <children>
                        <Label layoutX="40.0" layoutY="40.0" text="Total Books" />
                        <TextField fx:id="txtTotalBooks" layoutX="130.0" layoutY="37.0" />

                        <Label layoutX="380.0" layoutY="40.0" text="Total Members" />
                        <TextField fx:id="txtTotalMembers" layoutX="480.0" layoutY="37.0" />

                        <Label layoutX="40.0" layoutY="120.0" text="Borrowed Books" />
                        <TextField fx:id="txtBorrowedBooks" layoutX="130.0" layoutY="117.0" />

                        <Label layoutX="380.0" layoutY="120.0" text="Overdue Books" />
                        <TextField fx:id="txtOverDueBooks" layoutX="480.0" layoutY="117.0" />
                    </children>
                </AnchorPane>
            </children>
        </StackPane>

        <!-- Log Out Button (Always visible at the bottom) -->
        <Button fx:id="btnLogOut" layoutX="689.0" layoutY="567.0" mnemonicParsing="false" onAction="#btnOnActionLogOut" text="Log Out" />
    </children>
</AnchorPane>
