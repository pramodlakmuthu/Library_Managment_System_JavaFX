<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="820.0" stylesheets="/css/style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.Main_DashBoard_page_Controller">
    <children>
        <!-- Navigation Bar (Always visible at the top) -->
        <HBox fx:id="navBarBox" alignment="CENTER" layoutX="30.0" layoutY="20.0" prefHeight="45.0" prefWidth="760.0" spacing="12.0">
            <children>
                <Button fx:id="btnDashboard" mnemonicParsing="false" onAction="#btnOnActionDashboard" text="DashBoard" />
                <Button fx:id="btnAddBook" mnemonicParsing="false" onAction="#btnOnActionAddBook" text="Add Book" />
                <Button fx:id="btnAddMember" mnemonicParsing="false" onAction="#btnOnActionAddMember" text="Add Member" />
                <Button fx:id="btnView" mnemonicParsing="false" onAction="#btnOnActionView" text="View Members" />
                <Button fx:id="btnIssueBook" mnemonicParsing="false" onAction="#btnOnActionIssueBook" text="Issue Book" />
                <Button fx:id="btnReturnBook" mnemonicParsing="false" onAction="#btnOnActionReturnBook" text="Return Book" />
                <Button fx:id="btnHistory" mnemonicParsing="false" onAction="#btnOnActionHistory" text="History" />
            </children>
        </HBox>

        <!-- Content Area (Sub-pages load dynamically inside here) -->
        <StackPane fx:id="contentPane" layoutX="35.0" layoutY="85.0" prefHeight="450.0" prefWidth="750.0">
            <children>
                <!-- Default Dashboard Content / Statistics Fields -->
                <AnchorPane fx:id="dashboardContentPane" prefHeight="450.0" prefWidth="750.0">
                    <children>
                        <Label layoutX="50.0" layoutY="50.0" text="System Dashboard Overview">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>

                        <!-- Metric Card 1: Total Books -->
                        <Label layoutX="60.0" layoutY="120.0" style="-fx-font-weight: bold;" text="Total Books :" />
                        <TextField fx:id="txtTotalBooks" editable="false" layoutX="180.0" layoutY="115.0" prefHeight="30.0" prefWidth="150.0" style="-fx-alignment: center; -fx-font-size: 14px;" />

                        <!-- Metric Card 2: Total Members -->
                        <Label layoutX="400.0" layoutY="120.0" style="-fx-font-weight: bold;" text="Total Members :" />
                        <TextField fx:id="txtTotalMembers" editable="false" layoutX="530.0" layoutY="115.0" prefHeight="30.0" prefWidth="150.0" style="-fx-alignment: center; -fx-font-size: 14px;" />

                        <!-- Metric Card 3: Borrowed Books -->
                        <Label layoutX="60.0" layoutY="200.0" style="-fx-font-weight: bold;" text="Borrowed Books :" />
                        <TextField fx:id="txtBorrowedBooks" editable="false" layoutX="180.0" layoutY="195.0" prefHeight="30.0" prefWidth="150.0" style="-fx-alignment: center; -fx-font-size: 14px;" />

                        <!-- Metric Card 4: Overdue Books -->
                        <Label layoutX="400.0" layoutY="200.0" style="-fx-font-weight: bold;" text="Overdue Books :" />
                        <TextField fx:id="txtOverDueBooks" editable="false" layoutX="530.0" layoutY="195.0" prefHeight="30.0" prefWidth="150.0" style="-fx-alignment: center; -fx-font-size: 14px; -fx-text-fill: red;" />
                    </children>
                </AnchorPane>
            </children>
        </StackPane>

        <!-- Log Out Button (Always visible at the bottom right) -->
        <Button fx:id="btnLogOut" layoutX="685.0" layoutY="550.0" mnemonicParsing="false" onAction="#btnOnActionLogOut" prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: #e74c3c; -fx-text-fill: white;" text="Log Out" />
    </children>
</AnchorPane>