<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="450.0" prefWidth="750.0" stylesheets="/css/style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.AddBook.Add_Book_Page_Controller">
    <children>

        <Label layoutX="60.0" layoutY="25.0" text="Add New Book to Library">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>


        <Label layoutX="60.0" layoutY="80.0" style="-fx-font-weight: bold;" text="ISBN :" />
        <TextField fx:id="txtISBN" layoutX="180.0" layoutY="75.0" prefHeight="30.0" prefWidth="280.0" promptText="Enter book ISBN..." />

        <Label layoutX="60.0" layoutY="130.0" style="-fx-font-weight: bold;" text="Book Title :" />
        <TextField fx:id="txtBookTitle" layoutX="180.0" layoutY="125.0" prefHeight="30.0" prefWidth="280.0" promptText="Enter book title..." />

        <Label layoutX="60.0" layoutY="180.0" style="-fx-font-weight: bold;" text="Author :" />
        <TextField fx:id="txtAuthor" layoutX="180.0" layoutY="175.0" prefHeight="30.0" prefWidth="280.0" promptText="Enter author name..." />

        <Label layoutX="60.0" layoutY="230.0" style="-fx-font-weight: bold;" text="Category :" />
        <TextField fx:id="txtCategory" layoutX="180.0" layoutY="225.0" prefHeight="30.0" prefWidth="280.0" promptText="Enter book category..." />

        <Label layoutX="60.0" layoutY="280.0" style="-fx-font-weight: bold;" text="Published Year :" />
        <TextField fx:id="txtPublishedYear" layoutX="180.0" layoutY="275.0" prefHeight="30.0" prefWidth="280.0" promptText="e.g. 2023..." />

        <Label layoutX="60.0" layoutY="330.0" style="-fx-font-weight: bold;" text="Quantity :" />
        <TextField fx:id="txtQuantity" layoutX="180.0" layoutY="325.0" prefHeight="30.0" prefWidth="280.0" promptText="Enter total copies..." />


        <Button fx:id="btnAdd" layoutX="180.0" layoutY="385.0" mnemonicParsing="false" onAction="#btnOnActionAddBook" prefHeight="32.0" prefWidth="130.0" style="-fx-background-color: #27ae60; -fx-text-fill: white;" text="Add Book" />
        <Button fx:id="btnReset" layoutX="330.0" layoutY="385.0" mnemonicParsing="false" onAction="#btnOnActionReset" prefHeight="32.0" prefWidth="130.0" text="Reset" />
    </children>
</AnchorPane>