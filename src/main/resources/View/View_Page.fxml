<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="588.0" prefWidth="746.0" stylesheets="/css/style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.ViewPage.View_page_Controller">
    <children>
        <!-- Search Field -->
        <TextField fx:id="txtSearch" layoutX="30.0" layoutY="25.0" onKeyReleased="#txtSearchOnKeyReleased" prefHeight="32.0" prefWidth="320.0" promptText="Search by Name or ID..." />

        <!-- Members Table View -->
        <TableView fx:id="tblMembers" layoutX="30.0" layoutY="75.0" prefHeight="240.0" prefWidth="686.0">
            <columns>
                <TableColumn fx:id="colMemberId" prefWidth="100.0" text="Member ID" />
                <TableColumn fx:id="colName" prefWidth="140.0" text="Name" />
                <TableColumn fx:id="colEmail" prefWidth="150.0" text="Email" />
                <TableColumn fx:id="colAddress" prefWidth="156.0" text="Address" />
                <TableColumn fx:id="colMobile" prefWidth="139.0" text="Mobile" />
            </columns>
        </TableView>

        <!-- Edit/Update Form Fields -->
        <TextField fx:id="txtMemberId" editable="false" layoutX="30.0" layoutY="345.0" prefHeight="32.0" prefWidth="210.0" promptText="Member ID" />
        <TextField fx:id="txtName" layoutX="268.0" layoutY="345.0" prefHeight="32.0" prefWidth="210.0" promptText="Full Name" />
        <TextField fx:id="txtEmail" layoutX="506.0" layoutY="345.0" prefHeight="32.0" prefWidth="210.0" promptText="Email" />

        <TextField fx:id="txtAddress" layoutX="30.0" layoutY="395.0" prefHeight="32.0" prefWidth="320.0" promptText="Address" />
        <TextField fx:id="txtMobile" layoutX="376.0" layoutY="395.0" prefHeight="32.0" prefWidth="340.0" promptText="Mobile Number" />

        <!-- Action Buttons -->
        <Button fx:id="btnUpdate" layoutX="396.0" layoutY="455.0" mnemonicParsing="false" onAction="#btnOnActionUpdate" prefHeight="35.0" prefWidth="100.0" style="-fx-background-color: #2196F3; -fx-text-fill: white;" text="Update" />
        <Button fx:id="btnDelete" layoutX="506.0" layoutY="455.0" mnemonicParsing="false" onAction="#btnOnActionDelete" prefHeight="35.0" prefWidth="100.0" style="-fx-background-color: #f44336; -fx-text-fill: white;" text="Delete" />
        <Button fx:id="btnClear" layoutX="616.0" layoutY="455.0" mnemonicParsing="false" onAction="#btnOnActionClear" prefHeight="35.0" prefWidth="100.0" text="Clear" />
    </children>
</AnchorPane>