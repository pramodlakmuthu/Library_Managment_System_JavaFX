<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="588.0" prefWidth="746.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.Issue_Book.IssueController">
    <children>
        <Label layoutX="100.0" layoutY="100.0" text="Issue ID :" />
        <TextField fx:id="txtIssueId" layoutX="250.0" layoutY="95.0" prefWidth="250.0" promptText="e.g. ISS-001" />

        <Label layoutX="100.0" layoutY="160.0" text="Select Member :" />
        <ComboBox fx:id="cmbMembers" layoutX="250.0" layoutY="155.0" prefWidth="250.0" promptText="Select Member ID / Name" />

        <Label layoutX="100.0" layoutY="220.0" text="Select Book :" />
        <ComboBox fx:id="cmbBooks" layoutX="250.0" layoutY="215.0" prefWidth="250.0" promptText="Select Book ISBN / Title" />

        <Label layoutX="100.0" layoutY="280.0" text="Issue Date :" />
        <DatePicker fx:id="dateIssue" layoutX="250.0" layoutY="275.0" prefWidth="250.0" />

        <Label layoutX="100.0" layoutY="340.0" text="Due Date :" />
        <DatePicker fx:id="dateDue" layoutX="250.0" layoutY="335.0" prefWidth="250.0" />

        <Button fx:id="btnIssueBook" layoutX="250.0" layoutY="410.0" mnemonicParsing="false" onAction="#btnOnActionIssueBook" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Issue Book" />
        <Button fx:id="btnClear" layoutX="380.0" layoutY="410.0" mnemonicParsing="false" onAction="#btnOnActionClear" prefHeight="35.0" prefWidth="120.0" text="Clear" />
    </children>
</AnchorPane>